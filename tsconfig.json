{
  "compilerOptions": {
    /* === Target e ambiente === */
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,

    /* === Tipagem e qualidade === */
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* === React / Next.js === */
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],

    /* === Paths (alias @/) === */
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    }
  },

  /* === Arquivos incluídos === */
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/types/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],

  /* === Excluir === */
  "exclude": ["node_modules", "dist"]
}
